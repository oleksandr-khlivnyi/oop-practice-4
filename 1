#include <iostream> 

#include <cstdlib> 

#include <ctime> 

 

using namespace std; 

 

int main() { 

    int n; 

    int arr[100]; 

    int sum = 0; 

 

    cin >> n; 

 

    srand(time(0)); 

    for (int i = 0; i < n; i++) { 

        arr[i] = rand() % 100; 

        cout << arr[i] << " "; 

    } 

    cout << endl; 

 

    for (int i = 0; i < n; i++) { 

        if (arr[i] % 2 == 0) { 

            sum += arr[i]; 

        } 

    } 

 

    cout << sum << endl; 

 

    return 0; 

}
